package db

import (
	_ "modernc.org/sqlite"

	"github.com/tobibamidele/lathe"
	"github.com/tobibamidele/lathe/sqlite"

	"{{.Module}}/internal/config"
)

// DB is lathe's SQLite handle. The generated package adds the Client, models
// and typed columns (see internal/schema); handlers build a client on top of
// this with db.NewClient(d.DB).
type DB = lathe.DB

func Connect(cfg *config.Config) (*DB, error) {
	return sqlite.Open(cfg.DatabaseURL)
}

func Close(d *DB) { _ = d.Close() }