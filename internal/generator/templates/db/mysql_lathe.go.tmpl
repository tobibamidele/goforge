package db

import (
	_ "github.com/go-sql-driver/mysql"

	"github.com/tobibamidele/lathe"
	"github.com/tobibamidele/lathe/mysql"

	"{{.Module}}/internal/config"
)

// DB is lathe's MySQL handle. The generated package adds the Client, models
// and typed columns (see internal/schema); handlers build a client on top of
// this with db.NewClient(d.DB).
type DB = lathe.DB

func Connect(cfg *config.Config) (*DB, error) {
	return mysql.Open(cfg.DatabaseURL)
}

func Close(d *DB) { _ = d.Close() }