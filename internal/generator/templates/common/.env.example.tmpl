PORT=8080
ENV=development

{{- if .HasDatabase}}

# {{.Database}} connection
DATABASE_URL={{if eq .Database "postgres"}}postgres://postgres:postgres@localhost:5432/{{.Name}}?sslmode=disable{{end}}{{if eq .Database "mysql"}}root:root@tcp(localhost:3306)/{{.Name}}?parseTime=true{{end}}{{if eq .Database "sqlite"}}file:{{.Name}}.db?cache=shared&_fk=1{{end}}{{if eq .Database "mongodb"}}mongodb://localhost:27017/{{.Name}}{{end}}
{{- end}}
{{- if .UseRedis}}

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
{{- end}}
{{- if .UseAuth}}

# Auth
{{- if eq .AuthType "jwt"}}
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
{{- end}}
{{- if eq .AuthType "session"}}
SESSION_SECRET=change-me-session-secret
SESSION_TTL_HOURS=168
{{- end}}
{{- end}}
{{- if .UseOAuth}}

# OAuth (fill in real credentials from each provider's console)
OAUTH_BASE_URL=http://localhost:8080
{{- range .OAuthProviders}}
{{upper .}}_CLIENT_ID=
{{upper .}}_CLIENT_SECRET=
{{- end}}
{{- end}}
