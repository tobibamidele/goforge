{{if and (eq .AuthType "session") (eq .Framework "fiber") -}}
package auth

import (
	{{- if .UseOAuth}}
	"net/http"
	{{- end}}
	"time"

	"github.com/gofiber/fiber/v2"
	{{- if .UseOAuth}}
	"github.com/gofiber/fiber/v2/middleware/adaptor"
	"github.com/markbates/goth/gothic"
	{{- end}}
)

type registerReq struct {
	Email    string `json:"email"`
	Password string `json:"password"`
}

func RegisterRoutesFiber(app *fiber.App, svc *Service) {
	{{- if .UseOAuth}}
	InitOAuth(svc.cfg)
	{{- end}}

	setCookie := func(c *fiber.Ctx, sess *Session) {
		c.Cookie(&fiber.Cookie{
			Name:     CookieName,
			Value:    sess.ID,
			Expires:  sess.ExpiresAt,
			HTTPOnly: true,
			SameSite: "Lax",
		})
	}

	g := app.Group("/auth")
	g.Post("/register", func(c *fiber.Ctx) error {
		var req registerReq
		if err := c.BodyParser(&req); err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": err.Error()})
		}
		sess, err := svc.Register(c.Context(), req.Email, req.Password)
		if err != nil {
			return c.Status(fiber.StatusConflict).JSON(fiber.Map{"error": err.Error()})
		}
		setCookie(c, sess)
		return c.Status(fiber.StatusCreated).JSON(fiber.Map{"status": "ok"})
	})
	g.Post("/login", func(c *fiber.Ctx) error {
		var req registerReq
		if err := c.BodyParser(&req); err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": err.Error()})
		}
		sess, err := svc.Login(c.Context(), req.Email, req.Password)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{"error": err.Error()})
		}
		setCookie(c, sess)
		return c.JSON(fiber.Map{"status": "ok"})
	})
	g.Post("/logout", func(c *fiber.Ctx) error {
		if id := c.Cookies(CookieName); id != "" {
			_ = svc.Logout(id)
		}
		c.Cookie(&fiber.Cookie{Name: CookieName, Value: "", Expires: time.Now().Add(-time.Hour)})
		return c.JSON(fiber.Map{"status": "ok"})
	})
	{{- if .UseOAuth}}
	g.Get("/:provider", func(c *fiber.Ctx) error {
		provider := c.Params("provider")
		return adaptor.HTTPHandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			gothic.BeginAuthHandler(w, withProvider(r, provider))
		})(c)
	})
	g.Get("/:provider/callback", func(c *fiber.Ctx) error {
		provider := c.Params("provider")
		return adaptor.HTTPHandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			handleOAuthCallback(w, withProvider(r, provider), svc)
		})(c)
	})
	{{- end}}

	app.Get("/me", RequireAuth(svc), func(c *fiber.Ctx) error {
		sess := c.Locals("session").(*Session)
		return c.JSON(fiber.Map{"user_id": sess.UserID, "data": sess.Data})
	})
}

// RequireAuth reads the session cookie, validates it, and stashes the
// Session in c.Locals("session").
func RequireAuth(svc *Service) fiber.Handler {
	return func(c *fiber.Ctx) error {
		id := c.Cookies(CookieName)
		if id == "" {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{"error": "missing session cookie"})
		}
		sess, err := svc.ReadSession(id)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{"error": err.Error()})
		}
		c.Locals("session", sess)
		return c.Next()
	}
}
{{- end}}
