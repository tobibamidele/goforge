{{if and (eq .AuthType "session") (eq .Framework "nethttp") -}}
package auth

import (
	"encoding/json"
	"net/http"
	"time"
	{{- if .UseOAuth}}

	"github.com/markbates/goth/gothic"
	{{- end}}
)

type registerReq struct {
	Email    string `json:"email"`
	Password string `json:"password"`
}

func RegisterRoutesNetHTTP(mux *http.ServeMux, svc *Service) {
	{{- if .UseOAuth}}
	InitOAuth(svc.cfg)
	{{- end}}

	setCookie := func(w http.ResponseWriter, sess *Session) {
		http.SetCookie(w, &http.Cookie{
			Name:     CookieName,
			Value:    sess.ID,
			Path:     "/",
			Expires:  sess.ExpiresAt,
			HttpOnly: true,
			SameSite: http.SameSiteLaxMode,
		})
	}

	mux.HandleFunc("POST /auth/register", func(w http.ResponseWriter, r *http.Request) {
		var req registerReq
		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
			writeJSON(w, http.StatusBadRequest, map[string]string{"error": err.Error()})
			return
		}
		sess, err := svc.Register(r.Context(), req.Email, req.Password)
		if err != nil {
			writeJSON(w, http.StatusConflict, map[string]string{"error": err.Error()})
			return
		}
		setCookie(w, sess)
		writeJSON(w, http.StatusCreated, map[string]string{"status": "ok"})
	})
	mux.HandleFunc("POST /auth/login", func(w http.ResponseWriter, r *http.Request) {
		var req registerReq
		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
			writeJSON(w, http.StatusBadRequest, map[string]string{"error": err.Error()})
			return
		}
		sess, err := svc.Login(r.Context(), req.Email, req.Password)
		if err != nil {
			writeJSON(w, http.StatusUnauthorized, map[string]string{"error": err.Error()})
			return
		}
		setCookie(w, sess)
		writeJSON(w, http.StatusOK, map[string]string{"status": "ok"})
	})
	mux.HandleFunc("POST /auth/logout", func(w http.ResponseWriter, r *http.Request) {
		if c, err := r.Cookie(CookieName); err == nil {
			_ = svc.Logout(c.Value)
		}
		http.SetCookie(w, &http.Cookie{Name: CookieName, Value: "", Path: "/", Expires: time.Now().Add(-time.Hour)})
		writeJSON(w, http.StatusOK, map[string]string{"status": "ok"})
	})
	{{- if .UseOAuth}}
	mux.HandleFunc("GET /auth/{provider}", func(w http.ResponseWriter, r *http.Request) {
		gothic.BeginAuthHandler(w, withProvider(r, r.PathValue("provider")))
	})
	mux.HandleFunc("GET /auth/{provider}/callback", func(w http.ResponseWriter, r *http.Request) {
		handleOAuthCallback(w, withProvider(r, r.PathValue("provider")), svc)
	})
	{{- end}}

	mux.Handle("GET /me", RequireAuth(svc)(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		sess, _ := SessionFromContext(r.Context())
		writeJSON(w, http.StatusOK, map[string]any{"user_id": sess.UserID, "data": sess.Data})
	})))
}

// RequireAuth reads the session cookie, validates it, and stashes the
// Session on the request context.
func RequireAuth(svc *Service) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			c, err := r.Cookie(CookieName)
			if err != nil || c.Value == "" {
				writeJSON(w, http.StatusUnauthorized, map[string]string{"error": "missing session cookie"})
				return
			}
			sess, err := svc.ReadSession(c.Value)
			if err != nil {
				writeJSON(w, http.StatusUnauthorized, map[string]string{"error": err.Error()})
				return
			}
			next.ServeHTTP(w, r.WithContext(WithSession(r.Context(), sess)))
		})
	}
}

func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}
{{- end}}
